PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rms_db
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (for Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payment Gateway Credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fixed Admin & Manager Credentials
MAIN_ADMIN_EMAIL=admin@savoria.com
MAIN_ADMIN_PASSWORD=Admin@123456
MANAGER_EMAIL=manager@savoria.com
MANAGER_PASSWORD=Manager@123456

# Timezone used for "today", reservations and reports
RESTAURANT_TIMEZONE=Asia/Dhaka
# Extra allowed front-end URLs (comma separated), e.g. your deployed site
CLIENT_URLS=
